{
  "name": "@quan/videos-song-generate",
  "version": "1.0.0",
  "description": "Quản lý bài hát tạo từ Suno AI: prompt gửi lên Suno, file MP3, link YouTube publish và lời bài hát dạng Markdown",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "import": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./styles.css": "./src/styles/songs.css",
    "./next/pages/songs": "./src/next/pages/songs/page.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/build-songs-data.mjs",
    "song:sync": "node scripts/build-songs-data.mjs",
    "song:create": "node scripts/new-song.mjs",
    "song:validate": "node scripts/validate-songs.mjs",
    "build": "node scripts/build-songs-data.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quan/theme-glassmorphism": "file:../theme-glassmorphism"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "suno",
    "suno-ai",
    "songs",
    "music-generation",
    "youtube-songs",
    "mp3",
    "markdown-songs",
    "prompts",
    "lyrics"
  ]
}

